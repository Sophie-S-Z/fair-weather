{
  "name": "fair-weather",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run --project unit",
    "test:prop": "vitest run --project property",
    "test:golden": "vitest run --project golden --passWithNoTests",
    "test:e2e": "playwright test --project=e2e --project=visual",
    "test:perf": "playwright test --project=perf",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "validate-content": "node tools/content-validate/validate.ts",
    "rig": "node tools/svg-to-rig/cli.ts"
  },
  "dependencies": {
    "inkjs": "2.4.0",
    "pixi.js": "8.22.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@types/node": "22.20.5",
    "eslint": "10.14.0",
    "fast-check": "4.10.2",
    "globals": "17.14.0",
    "prettier": "3.9.10",
    "svg-path-properties": "2.2.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vitest": "5.1.0"
  }
}
