{
  "name": "fair-weather",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run --project unit --project golden",
    "test:prop": "vitest run --project property",
    "test:golden": "vitest run --project golden",
    "test:e2e": "playwright test --project=e2e --project=e2e-firefox --project=e2e-webkit --project=visual",
    "test:perf": "playwright test --project=perf",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit && svelte-check --tsconfig ./tsconfig.json",
    "validate-content": "node tools/content-validate/validate.ts",
    "rig": "node tools/svg-to-rig/cli.ts"
  },
  "dependencies": {
    "inkjs": "2.4.0",
    "pixi.js": "8.22.0",
    "svelte": "5.57.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@types/node": "22.20.5",
    "eslint": "10.14.0",
    "eslint-plugin-svelte": "3.24.1",
    "fake-indexeddb": "6.2.8",
    "fast-check": "4.10.2",
    "globals": "17.14.0",
    "prettier": "3.9.10",
    "prettier-plugin-svelte": "4.1.1",
    "svelte-check": "4.7.8",
    "svg-path-properties": "2.2.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vitest": "5.1.0"
  }
}
